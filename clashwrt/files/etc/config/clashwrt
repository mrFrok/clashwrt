config clashwrt 'config'
	# The proxy kill switch. Owned by the Overview page (powerctl.sh); '0'
	# leaves the router forwarding everything directly.
	option enabled '0'

	# tproxy       - TCP+UDP through nft tproxy into mihomo's tproxy-port.
	#                Fastest and most correct, but silently broken on some
	#                kernels (rule matches, socket never receives).
	# tproxy_tun   - TCP through tproxy, UDP through the tun device.
	#                For kernels where tproxy works for TCP only.
	# tun          - TCP+UDP both through the tun device. Works everywhere,
	#                costs throughput.
	# redirect_tun - TCP through a NAT redirect, UDP through the tun device.
	#                The portable fallback when tproxy is unusable: NAT always
	#                works, but cannot carry UDP, so UDP takes the tun.
	option mode 'redirect_tun'

	# 'auto' asks netifd which device currently backs lan/wan. Set a device
	# name explicitly to override. lan_device may also be a list of networks
	# (lan, guest, iot) or devices: every one of them is intercepted.
	option lan_device 'auto'
	option wan_device 'auto'
	option tun_device 'clash-tun'
	option mihomo_dir '/etc/mihomo'
	option list_subdir 'lst'

	# mihomo tags its own outbound sockets with this mark (routing-mark in
	# config.yaml). Traffic carrying it is never re-intercepted, otherwise
	# mihomo's own connections loop back into mihomo.
	option self_mark '2'

	# Ports are read from mihomo's config.yaml so the firewall cannot drift
	# from the daemon. Set them here only to override that.
	# option tproxy_port '7894'
	# option redir_port '7893'
	option dns_port '1053'
	option api_port '9090'

	# Reject QUIC (UDP/443) so browsers fall back to TCP. Only worth enabling
	# when UDP is not proxied well.
	option block_quic '0'

	# Force LAN DNS into mihomo's resolver. Leave off if dnsmasq already
	# forwards to mihomo.
	option dns_hijack '0'

	# Manage a fw4 zone for the tun device automatically. Without it,
	# forwarded traffic to/from the tun is rejected by fw4's own forward
	# chain regardless of what any other table accepts.
	option manage_zone '1'

	option mark_tproxy '1'
	option mark_tun '3'
	option table_tproxy '100'
	option table_tun '151'
	option rule_pref '1002'
	option tun_wait '10'


	# Skip the proxy entirely for a set of destinations, decided in the kernel
	# before any marking happens. A DIRECT rule inside mihomo is not a fast
	# path -- the connection still terminates on the router and is relayed
	# through userspace.
	#   off      intercept everything (then mihomo's rules decide)
	#   exclude  listed destinations bypass; pair with "proxy except Russia"
	#   include  only listed destinations are intercepted; pair with
	#            "direct except the lists"
	#   auto     read the direction out of mihomo's terminal MATCH rule
	#            instead of being told it -- the set holds the exceptions to
	#            whatever mihomo does by default, so the default decides which
	#            way round it goes. 'setctl.sh detect' shows the answer and
	#            where it came from.
	option bypass_set_mode 'auto'
	option bypass_set_source 'config'
	# set once the default above has been applied; see uci-defaults
	option bypass_set_defaulted '1'
	# option bypass_set_url ''
	option bypass_set_interval '86400'
	# Also put into the set what config.yaml's own rules name: with
	# 'include', the addresses and domains they send to a proxy (domains
	# through dnsmasq's nftset=, which needs dnsmasq-full); with 'exclude',
	# the addresses they send DIRECT. bypass_set_source 'config' uses only
	# this, with nothing downloaded.
	option bypass_set_from_config '1'

	list bypass_net '0.0.0.0/8'
	list bypass_net '10.0.0.0/8'
	list bypass_net '100.64.0.0/10'
	list bypass_net '127.0.0.0/8'
	list bypass_net '169.254.0.0/16'
	list bypass_net '172.16.0.0/12'
	list bypass_net '192.168.0.0/16'
	list bypass_net '224.0.0.0/4'
	list bypass_net '240.0.0.0/4'

	# Fail-open watchdog. When the proxy path stops working but the internet
	# itself is fine, traffic goes direct until the path is healthy again,
	# instead of the whole network going down with the VPN. Off by default;
	# it never switches the proxy on, and switching the proxy off always wins.
	# The router's own downloads (mihomo core, ClashWrt updates, dashboards,
	# bypass lists) go through the proxy first and directly only if that
	# fails. The wizard's config has a loopback listener for this, on
	# fetch_port, that sends everything to the Proxy group.
	# While the proxy is on, refuse LAN IPv6 to the internet: interception is
	# IPv4 only, so IPv6 would go past the proxy with the real address. Apps
	# fall back to IPv4. Set '0' if you need IPv6 and accept that it is direct.
	option block_ipv6 '1'

	# Refuse encrypted DNS that skips the router: DoT (port 853), and DoH to
	# public resolvers from dibdot's DoH-IP-blocklists (refreshed daily, plus
	# doh_extra). Devices fall back to the router's DNS.
	option block_dot '1'
	option block_doh '0'
	# list doh_extra '203.0.113.53'

	# Keep mihomo's rule and proxy providers in RAM, so their refreshes do not
	# wear the flash -- only while RAM can spare it (provctl.sh): never under
	# 256 MB, and back to flash when free RAM or /tmp runs low.
	option providers_in_ram '1'

	option fetch_via_proxy '1'
	option fetch_port '7899'

	option watchdog '0'

	# Which proxy group to time. Empty = the group named by the terminal
	# MATCH rule of config.yaml, else "Proxy".
	option watchdog_group ''

	# Consecutive failed probes before bypassing, and passes before restoring.
	option watchdog_fail '3'
	option watchdog_ok '3'

	# Seconds between probes: normal, and while a decision is pending.
	option watchdog_interval '20'
	option watchdog_fast '5'

	# Shortest time a bypass lasts, doubling when the path keeps failing again
	# within ten minutes of coming back, up to the maximum.
	option watchdog_hold '120'
	option watchdog_hold_max '900'

	# After the watchdog starts (boot, or a settings change) it only watches.
	option watchdog_grace '90'

	# Seconds a probe waits for an answer.
	option watchdog_timeout '5'

	# URLs that answer HTTP 204. Defaults to three well-known ones;
	# watchdog_url is tried through the proxy, watchdog_ctl_url out of the WAN.
	# list watchdog_url 'http://www.gstatic.com/generate_204'
	# list watchdog_ctl_url 'http://www.gstatic.com/generate_204'
