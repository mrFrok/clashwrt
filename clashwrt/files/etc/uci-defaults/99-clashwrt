#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Persist the sysctl that NAT-to-loopback depends on. Without route_localnet
# the martian filter drops packets DNAT'ed to 127.0.0.1, which is exactly what
# redirect_tun mode does for TCP.

[ -f /etc/sysctl.d/99-clashwrt.conf ] || cat > /etc/sysctl.d/99-clashwrt.conf <<'EOF'
net.ipv4.conf.all.route_localnet=1
net.ipv4.conf.default.route_localnet=1
EOF

sysctl -p /etc/sysctl.d/99-clashwrt.conf >/dev/null 2>&1

# Refresh the bypass address list once a day. setctl honours its own interval,
# so this only goes to the network when the list is actually stale.
if ! grep -q "clashwrt/setctl.sh" /etc/crontabs/root 2>/dev/null; then
	mkdir -p /etc/crontabs
	echo "17 4 * * * /usr/libexec/clashwrt/setctl.sh update >/dev/null 2>&1" >> /etc/crontabs/root
	/etc/init.d/cron restart >/dev/null 2>&1 || true
fi

# 1.2.2 turns the kernel bypass set on by default, built from config.yaml's
# own rules. A router that had it off gets the same, once: the marker keeps
# a later "off" from being undone by the next upgrade, and a router that
# chose a list of its own keeps it. setctl.sh holds the set back by itself
# when config.yaml proxies something it cannot hold, so this cannot send
# traffic past the proxy.
if [ -f /etc/config/clashwrt ] && [ -z "$(uci -q get clashwrt.config.bypass_set_defaulted)" ]; then
	case "$(uci -q get clashwrt.config.bypass_set_mode)" in
		""|off)
			uci -q set clashwrt.config.bypass_set_mode=auto
			uci -q set clashwrt.config.bypass_set_source=config
			BYPASS_NEW=1
			;;
	esac
	uci -q set clashwrt.config.bypass_set_defaulted=1
	uci -q commit clashwrt
	# a running service builds the set now rather than at the next reboot
	if [ -n "${BYPASS_NEW:-}" ] && [ -x /etc/init.d/clashwrt ]; then
		/etc/init.d/clashwrt running >/dev/null 2>&1 && /usr/libexec/clashwrt/fw.sh apply >/dev/null 2>&1
	fi
fi

exit 0
