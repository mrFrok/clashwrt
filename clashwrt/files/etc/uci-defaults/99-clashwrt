#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Persist the sysctl that NAT-to-loopback depends on. Without route_localnet
# the martian filter drops packets DNAT'ed to 127.0.0.1, which is exactly what
# redirect_tun mode does for TCP.

[ -f /etc/sysctl.d/99-clashwrt.conf ] || cat > /etc/sysctl.d/99-clashwrt.conf <<'EOF'
net.ipv4.conf.all.route_localnet=1
net.ipv4.conf.default.route_localnet=1
EOF

sysctl -p /etc/sysctl.d/99-clashwrt.conf >/dev/null 2>&1

# Refresh the bypass address list once a day. setctl honours its own interval,
# so this only goes to the network when the list is actually stale.
if ! grep -q "clashwrt/setctl.sh" /etc/crontabs/root 2>/dev/null; then
	mkdir -p /etc/crontabs
	echo "17 4 * * * /usr/libexec/clashwrt/setctl.sh update >/dev/null 2>&1" >> /etc/crontabs/root
	/etc/init.d/cron restart >/dev/null 2>&1 || true
fi

exit 0
