msgstr "Настройки"

msgid "Configuration"
msgstr "Конфигурация"

msgid "ClashWrt"
msgstr "ClashWrt"

msgid "checking…"
msgstr "проверка…"

msgid "unknown"
msgstr "неизвестно"

msgid "Applies to the configuration that is installed now, whether the wizard wrote it or you did. The result is checked before it replaces anything."
msgstr "Применяется к той конфигурации, которая установлена сейчас — неважно, написал её мастер или вы сами. Результат проверяется перед заменой."

msgid "unavailable"
msgstr "недоступно"

