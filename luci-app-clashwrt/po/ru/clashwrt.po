msgstr "mihomo перезапущен."

msgid "Restart mihomo"
msgstr "Перезапустить mihomo"

msgid "Open dashboard"
msgstr "Открыть панель"

msgid "If the panel still looks unchanged, reload its tab once — the previous dashboard holds it in the browser cache until then."
msgstr "Если панель выглядит по-прежнему, перезагрузите её вкладку один раз — до этого предыдущая панель держит её в кеше браузера."

msgid "filter, e.g. an IP or a domain"
msgstr "фильтр, например IP или домен"

