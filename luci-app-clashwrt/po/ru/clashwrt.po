msgstr "Строк"

msgid "Bytes"
msgstr "Байт"

msgid "Enter a file name first."
msgstr "Сначала укажите имя файла."

msgid "New file staged. It is created on the router when you save."
msgstr "Новый файл подготовлен. Он будет создан на роутере при сохранении."

msgid "New file"
msgstr "Новый файл"

msgid "Open or create a file first."
msgstr "Сначала откройте или создайте файл."

