msgstr "Восстановление…"

msgid "Restore selected"
msgstr "Восстановить выбранную"

msgid "nothing open"
msgstr "ничего не открыто"

msgid "Delete file"
msgstr "Удалить файл"

msgid "Delete %s? A config that still refers to it will fail to load."
msgstr "Удалить %s? Конфигурация, которая на него ссылается, перестанет загружаться."

msgid "Deleted."
msgstr "Удалено."

msgid "Delete"
msgstr "Удалить"

msgid "File"
msgstr "Файл"

