{
	"luci-app-clashwrt": {
		"description": "Grant access to mihomo transparent proxy settings",
		"read": {
			"ubus": {
				"file": [
					"read",
					"stat"
				],
				"uci": [
					"get"
				],
				"service": [
					"list"
				]
			},
			"uci": [
				"clashwrt",
				"network"
			]
		},
		"write": {
			"file": {
				"/etc/init.d/clashwrt": [
					"exec"
				],
				"/usr/libexec/clashwrt/fw.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/confctl.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/filectl.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/uictl.sh": [
					"exec"
				],
				"/tmp/clashwrt-staging": [
					"write"
				],
				"/etc/init.d/mihomo": [
					"exec"
				],
				"/usr/libexec/clashwrt/logctl.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/updctl.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/setctl.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/powerctl.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/watchdog.sh": [
					"exec"
				],
				"/usr/libexec/clashwrt/provctl.sh": [
					"exec"
				],
				"/tmp/clashwrt-settings.tar.gz": [
					"read"
				],
				"/tmp/clashwrt-settings-restore.tar.gz": [
					"write"
				]
			},
			"ubus": {
				"file": [
					"exec",
					"write"
				],
				"uci": [
					"set",
					"commit",
					"add",
					"delete",
					"order",
					"apply"
				]
			},
			"uci": [
				"clashwrt",
				"firewall"
			]
		}
	}
}
